# Copie ce fichier en `.env` et remplis tes valeurs.
# Le `.env` est lu automatiquement par l'outil au démarrage.

# Provider LLM (anthropic | gemini | openai)
LLM_PROVIDER=anthropic

# Modèle utilisé. Exemples :
#   anthropic : claude-sonnet-4-6, claude-haiku-4-5
#   gemini    : gemini-2.5-flash, gemini-2.5-pro
#   openai    : gpt-4o, gpt-4o-mini
LLM_MODEL=claude-sonnet-4-6

# Clés API (renseigne celle correspondant au provider choisi)
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
